# Database
# Docker Compose uses the internal database service name. Do not change this to
# localhost unless you are running the app directly on the host.
DATABASE_URL="postgresql://flexdocs:change-this-password@db:5432/flexdocs"

# NextAuth
NEXTAUTH_SECRET="generate-a-strong-secret-here"
NEXTAUTH_URL="https://docs.example.com"

# Encryption key (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="generate-a-strong-key-here"

# Redis
REDIS_URL="redis://redis:6379"

# SMTP (for email notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FlexDocs <noreply@flexdocs.local>"
SMTP_SECURE=false

# Logging
LOG_LEVEL="info"

# Backup
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30

# PocketID (optional - leave empty to disable passkey auth)
POCKETID_CLIENT_ID=""
POCKETID_CLIENT_SECRET=""
POCKETID_ISSUER=""

# Database password (for docker-compose)
DB_PASSWORD="change-this-password"

# AI assistant (optional — BYO key; OpenAI-compatible endpoint)
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL="https://api.openai.com/v1"

# First admin creation only. Generate with: openssl rand -hex 24
BOOTSTRAP_ADMIN_PASSWORD="generate-a-unique-password-here"
